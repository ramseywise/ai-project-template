@pytest.mark.asyncio
async def test_stall_detector_wired_into_tool_loop(monkeypatch: pytest.MonkeyPatch) -> None:
    """StallDetector.record_tool_call must be reached for every tool call.

    Remove the ``stall.record_tool_call(...)`` line from generate.py and this
    test fails: record_tool_call will never be called and the assertion trips.
    """
    record_calls: list[tuple[str, object]] = []

    real_StallDetector = generate_module.StallDetector

    class _SpyStallDetector(real_StallDetector):
        def record_tool_call(self, tool_name: str, tool_input: object) -> None:
            record_calls.append((tool_name, tool_input))
            super().record_tool_call(tool_name, tool_input)

    monkeypatch.setattr(generate_module, "StallDetector", _SpyStallDetector)

    call_n = {"n": 0}

    async def _fake_agenerate(system_prompt: str, messages: list[dict], tools=None):
        call_n["n"] += 1
        if call_n["n"] == 1:
            return SimpleNamespace(
                stop_reason="tool_use",
                usage=SimpleNamespace(input_tokens=10, output_tokens=5),
                content=[
                    SimpleNamespace(type="tool_use", name="lookup", input={"q": "x"}, id="t1")
                ],
            )
        return SimpleNamespace(
            stop_reason="end_turn",
            usage=SimpleNamespace(input_tokens=10, output_tokens=5),
            content=[SimpleNamespace(type="text", text="done")],
        )

    class _FakeTool:
        name = "lookup"
        description = "fake"
        args_schema: ClassVar[dict] = {"type": "object", "properties": {}}

        async def ainvoke(self, args: dict) -> str:
            return "result"

    async def _one_fake_tool():
        return [_FakeTool()]

    monkeypatch.setattr(generate_module, "agenerate", _fake_agenerate)
    monkeypatch.setattr(generate_module, "get_mcp_tools", _one_fake_tool)

    state: State = {"message": "needs a tool", "blocked": False, "context_snippets": []}
    await generate_node(state)

    assert len(record_calls) >= 1, (
        "record_tool_call was never invoked — stall_detector is not wired into the tool loop"
    )
    assert record_calls[0][0] == "lookup"


@pytest.mark.asyncio
async def test_context_budget_track_usage_wired(monkeypatch: pytest.MonkeyPatch) -> None:
    """track_usage must be called after every agenerate response.

    Remove the ``track_usage(response)`` line from generate.py and this test
    fails: track_usage_calls stays 0.
    """
    track_usage_calls: list[object] = []

    real_track_usage = generate_module.track_usage

    def _spy_track_usage(response, **kwargs):
        track_usage_calls.append(response)
        return real_track_usage(response, **kwargs)

    monkeypatch.setattr(generate_module, "track_usage", _spy_track_usage)

    async def _fake_agenerate(system_prompt: str, messages: list[dict], tools=None):
        return SimpleNamespace(
            stop_reason="end_turn",
            usage=SimpleNamespace(input_tokens=100, output_tokens=20),
            content=[SimpleNamespace(type="text", text="answer")],
        )

    async def _no_tools():
        return []

    monkeypatch.setattr(generate_module, "agenerate", _fake_agenerate)
    monkeypatch.setattr(generate_module, "get_mcp_tools", _no_tools)

    state: State = {"message": "hello", "blocked": False, "context_snippets": []}
    await generate_node(state)

    assert len(track_usage_calls) >= 1, (
        "track_usage was never called — context_budget is not wired into generate_node"
    )


@pytest.mark.asyncio
async def test_chat_span_wired_with_real_token_attributes(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """chat_span must be entered AND the span must carry real token counts.

    Two things are verified:
    1. The span is entered (entry_count >= 1).
    2. After agenerate returns, generate_node calls span.set_attribute with the
       response's actual input/output token counts and stop_reason — not zeros.

    Remove the ``with chat_span(...) as _span:`` block entirely and (1) fails.
    Remove or skip the ``_span.set_attribute(...)`` calls and (2) fails.
    """
    from contextlib import contextmanager

    entry_count: list[int] = []
    # Collect (attr_name, value) pairs set on the spy span after the call.
    set_attrs: dict[str, object] = {}

    class _SpySpan:
        """Minimal span stand-in that records set_attribute calls."""

        def set_attribute(self, key: str, value: object) -> None:
            set_attrs[key] = value

    @contextmanager
    def _spy_chat_span(**kwargs):
        entry_count.append(1)
        yield _SpySpan()

    monkeypatch.setattr(generate_module, "chat_span", _spy_chat_span)

    _INPUT_TOKENS = 123
    _OUTPUT_TOKENS = 45
    _FINISH_REASON = "end_turn"

    async def _fake_agenerate(system_prompt: str, messages: list[dict], tools=None):
        return SimpleNamespace(
            stop_reason=_FINISH_REASON,
            usage=SimpleNamespace(input_tokens=_INPUT_TOKENS, output_tokens=_OUTPUT_TOKENS),
            content=[SimpleNamespace(type="text", text="spanned answer")],
        )

    async def _no_tools():
        return []

    monkeypatch.setattr(generate_module, "agenerate", _fake_agenerate)
    monkeypatch.setattr(generate_module, "get_mcp_tools", _no_tools)

    state: State = {"message": "hello", "blocked": False, "context_snippets": []}
    await generate_node(state)

    assert len(entry_count) >= 1, (
        "chat_span was never entered — spans are not wired into generate_node"
    )
    assert set_attrs.get("gen_ai.usage.input_tokens") == _INPUT_TOKENS, (
        f"span.set_attribute('gen_ai.usage.input_tokens', ...) not called with {_INPUT_TOKENS}; "
        f"got {set_attrs} — token attributes not wired into the span"
    )
    assert set_attrs.get("gen_ai.usage.output_tokens") == _OUTPUT_TOKENS, (
        f"span.set_attribute('gen_ai.usage.output_tokens', ...) not called with {_OUTPUT_TOKENS}; "
        f"got {set_attrs} — token attributes not wired into the span"
    )
    assert set_attrs.get("gen_ai.response.finish_reasons") == _FINISH_REASON, (
        f"span.set_attribute('gen_ai.response.finish_reasons', ...) not called with {_FINISH_REASON!r}; "
        f"got {set_attrs} — finish_reason not wired into the span"
    )
