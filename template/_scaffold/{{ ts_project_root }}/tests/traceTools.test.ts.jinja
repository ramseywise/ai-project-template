/**
 * Tests for traceTools.ts — `wrapToolsWithSpans`.
 *
 * Verifies that the execute_tool OTel span:
 *   1. Has non-zero duration (opens before execute, closes after)
 *   2. Is marked is_error=true and status=ERROR when execute throws
 *   3. Always ends even on throw (finally block)
 *
 * These tests exercise the real wrapToolsWithSpans implementation with a
 * controlled startExecuteToolSpan mock so span state is observable.  They
 * FAIL if the span-bracketing wrapper is removed from traceTools.ts.
 *
 * ESM note: tracing.js is mocked via jest.unstable_mockModule so the span
 * object is controlled without making real OTel calls.  wrapToolsWithSpans
 * is imported dynamically after the mock is registered.
 */

import { jest, describe, it, expect, beforeAll } from "@jest/globals";

// ---------------------------------------------------------------------------
// Span mock factory — created fresh per test via mockImplementationOnce
// ---------------------------------------------------------------------------

function makeSpanMock() {
  return {
    setStatus: jest.fn(),
    setAttribute: jest.fn(),
    end: jest.fn(),
    // timestamps set by the mock's start/end hooks
    startedAt: 0,
    endedAt: 0,
  };
}

// Shared mock for startExecuteToolSpan — the real tracing.ts is replaced
const mockStartExecuteToolSpan = jest.fn();
const mockInputHash = jest.fn(() => "deadbeef");

jest.unstable_mockModule("../{{ ts_source_root }}/agent/tracing.js", () => ({
  startExecuteToolSpan: mockStartExecuteToolSpan,
  inputHash: mockInputHash,
  // Provide other named exports traceTools.ts might import (none currently,
  // but this guard prevents "not exported" errors if the file grows)
  startChatSpan: jest.fn(() => ({ end: jest.fn(), setStatus: jest.fn() })),
}));

// ---------------------------------------------------------------------------
// Subject import — dynamic, after mock is registered
// ---------------------------------------------------------------------------

let wrapToolsWithSpans: (toolSet: Record<string, unknown>) => Record<string, unknown>;

beforeAll(async () => {
  const mod = await import("../{{ ts_source_root }}/agent/traceTools.js");
  wrapToolsWithSpans = mod.wrapToolsWithSpans as typeof wrapToolsWithSpans;
});

// ---------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------

describe("wrapToolsWithSpans — execute_tool span", () => {
  it("span has non-zero duration: opens before execute, closes after", async () => {
    const span = makeSpanMock();
    let spanCreatedAt = 0;

    mockStartExecuteToolSpan.mockImplementationOnce(() => {
      spanCreatedAt = Date.now();
      // Wire end() to record when span closes
      span.end.mockImplementation(() => { span.endedAt = Date.now(); });
      return span;
    });

    const DELAY_MS = 5;
    const slowTool = {
      execute: async () => {
        await new Promise((r) => setTimeout(r, DELAY_MS));
        return "done";
      },
    };

    const wrapped = wrapToolsWithSpans({ slow: slowTool });
    await (wrapped.slow as { execute: () => Promise<unknown> }).execute();

    const duration = span.endedAt - spanCreatedAt;
    expect(duration).toBeGreaterThanOrEqual(DELAY_MS);
    expect(span.end).toHaveBeenCalledTimes(1);
    // Success path: OK status
    expect(span.setStatus).toHaveBeenCalledWith(
      expect.objectContaining({ code: 1 }), // SpanStatusCode.OK = 1
    );
  });

  it("span ends and is marked error when execute throws", async () => {
    const span = makeSpanMock();
    mockStartExecuteToolSpan.mockImplementationOnce(() => span);

    const failingTool = {
      execute: async () => { throw new Error("tool-failure"); },
    };

    const wrapped = wrapToolsWithSpans({ fail: failingTool });
    await expect(
      (wrapped.fail as { execute: () => Promise<unknown> }).execute(),
    ).rejects.toThrow("tool-failure");

    // finally block must always run — span must end
    expect(span.end).toHaveBeenCalledTimes(1);
    // Error attributes must be set
    expect(span.setAttribute).toHaveBeenCalledWith("is_error", true);
    expect(span.setStatus).toHaveBeenCalledWith(
      expect.objectContaining({ code: 2 }), // SpanStatusCode.ERROR = 2
    );
  });

  it("tools without execute are passed through unchanged", () => {
    mockStartExecuteToolSpan.mockClear();
    const noExec = { description: "no execute", inputSchema: {} };
    const wrapped = wrapToolsWithSpans({ noExec });
    // No execute to wrap — object reference is preserved
    expect(wrapped.noExec).toEqual(noExec);
    expect(mockStartExecuteToolSpan).not.toHaveBeenCalled();
  });
});
